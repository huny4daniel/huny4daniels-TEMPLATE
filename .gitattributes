* text=auto eol=lf

# 훅 스크립트·테스트는 Windows에서도 LF (bash가 CRLF를 명령의 일부로 읽음)
*.sh    text eol=lf
*.bash  text eol=lf
*.bats  text eol=lf
*.tsv   text eol=lf
*.env   text eol=lf
.github/hook-tests/fake-bin/* text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.jar  binary
*.exe  binary
