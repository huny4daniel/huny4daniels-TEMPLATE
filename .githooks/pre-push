#!/usr/bin/env bash
# git pre-push 훅 (ROADMAP E1): Claude Code를 거치지 않은 push에도 테스트와 spec 커버리지 검사를 건다.
# 명령은 .claude/hooks/checks.env의 TEST_CMD, SPEC_TEST_GLOB를 그대로 쓴다. 비어 있으면 건너뛴다.
# main/master·태그 push는 막지 않고 알림만 출력한다(사람의 판단 — Claude 경로에서는 guard.sh가 확인 창을 띄운다).
# 사람이 의도적으로 건너뛰려면 git push --no-verify.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
conf=.claude/hooks/checks.env
[[ -f $conf ]] || exit 0
TEST_CMD='' SPEC_TEST_GLOB=''
# shellcheck disable=SC1090
. "$conf"

# 표준 입력: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ _ remote_ref _; do
  case $remote_ref in
    refs/heads/main|refs/heads/master) echo "[pre-push] 알림: ${remote_ref#refs/heads/}에 직접 push합니다 (.claude/process/git-flow.md)" >&2 ;;
    refs/tags/*) echo "[pre-push] 알림: 태그 ${remote_ref#refs/tags/} push — 릴리즈 워크플로가 실행될 수 있습니다" >&2 ;;
  esac
done

fail=0
if [[ -n $TEST_CMD ]]; then
  if ! out=$(bash -c "$TEST_CMD" 2>&1); then
    echo "[pre-push] 테스트 실패 (.claude/hooks/checks.env TEST_CMD)" >&2
    printf '%s\n' "$out" | tail -n 30 >&2
    fail=1
  fi
fi
if [[ -n $SPEC_TEST_GLOB && -f .claude/hooks/spec-coverage.sh ]]; then
  if ! out=$(bash .claude/hooks/spec-coverage.sh 2>&1); then
    echo "[pre-push] spec 커버리지 실패" >&2
    printf '%s\n' "$out" >&2
    fail=1
  fi
fi
exit $fail
