#!/usr/bin/env bash
# 테스트용 가짜 gh: `gh pr checks`의 결과를 FAKE_GH_MODE로 고정한다.
# 실제 gh 종료 코드: 0 통과, 1 실패(또는 오류), 8 진행 중
[ -n "$FAKE_GH_LOG" ] && echo "$*" >> "$FAKE_GH_LOG"
case "$FAKE_GH_MODE" in
  pass)    printf 'build\tpass\t1m\thttps://x/1\ntest\tpass\t2m\thttps://x/2\n'; exit 0 ;;
  fail)    printf 'build\tpass\t1m\thttps://x/1\ntest\tfail\t2m\thttps://x/2\n'; exit 1 ;;
  pending) printf 'build\tpending\t0\thttps://x/1\n'; exit 8 ;;
  nochk)   echo "no checks reported on the 'feature/1-x' branch" >&2; exit 1 ;;
  nopr)    echo "no pull requests found for branch \"main\"" >&2; exit 1 ;;
  noauth)  echo "To get started with GitHub CLI, please run:  gh auth login" >&2; exit 4 ;;
  *)       echo "unknown FAKE_GH_MODE" >&2; exit 1 ;;
esac
