# 결정론적 검증 훅 설정 — check-file.sh(파일 수정 직후), check-turn.sh(응답 종료 시)가 읽는다.
# 비어 있는 항목은 건너뛴다. 3단계 Walking Skeleton에서 AGENTS.md 명령과 같게 채운다.
# 명령은 프로젝트 루트에서 실행된다. FORMAT/LINT 명령 뒤에는 수정된 파일 경로가 붙는다.

# 검사 대상 파일 (grep -E 정규식)
FILE_PATTERN='\.(py|ts|tsx|js|jsx|kt|kts|java)$'

# 파일 수정 직후 (빠른 것만)
FORMAT_CMD=''        # 예: 'uv run ruff format'      / 'pnpm exec prettier --write'
LINT_CMD=''          # 예: 'uv run ruff check --fix' / 'pnpm exec eslint --fix'

# 응답 종료 시 (코드가 바뀌었을 때만, 같은 상태로 이미 통과했으면 건너뜀)
TYPECHECK_CMD=''     # 예: 'uv run mypy .'           / 'pnpm exec tsc --noEmit'
TEST_CMD=''          # 예: 'uv run pytest -q'        / 'pnpm test --run' / './gradlew test'

# spec 커버리지 (ROADMAP G5, spec-coverage.sh): Done 기능의 시나리오마다 테스트에 ID가 있는지 응답 종료 시·CI에서 검사한다.
# SPEC_TEST_GLOB가 비어 있으면 검사하지 않는다. 3단계 Walking Skeleton에서 테스트 위치로 채운다.
SPEC_FILE='docs/SPEC.md'
SPEC_TEST_GLOB=''    # 예: 'tests/**/*.py'  / 'apps/**/*.test.ts packages/**/*.test.ts' / 'apps/android/app/src/test/**/*.kt'
